-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"467\" y=\"181\" fill=\"#1f4054\" font-size=\"26\" font-weight=\"900\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">FIT</text><rect x=\"647\" y=\"48\" width=\"254\" height=\"91\" rx=\"18\" fill=\"#fff2db\" stroke=\"#efdbb6\" stroke-width=\"2\"/><text x=\"672\" y=\"86\" fill=\"#94682a\" font-size=\"20\" font-weight=\"850\" text-anchor=\"start\" font-family=\"system-ui,Arial,sans-serif\">FUTURE OUTCOME</text><text x=\"672\" y=\"112\" fill=\"#567080\" font-size=\"16\" font-weight=\"700\" text-anchor=\"start\" font-family=\"system-ui,Arial,sans-serif\">Unavailable right now</text><rect x=\"647\" y=\"183\" width=\"254\" height=\"84\" rx=\"18\" fill=\"#ffebe9\" stroke=\"#efbfbb\" stroke-width=\"2\"/><text x=\"675\" y=\"218\" fill=\"#cc6963\" font-size=\"20\" font-weight=\"850\" text-anchor=\"start\" font-family=\"system-ui,Arial,sans-serif\">SCORE MIRAGE</text><text x=\"675\" y=\"247\" fill=\"#567080\" font-size=\"15\" font-weight=\"700\" text-anchor=\"start\" font-family=\"system-ui,Arial,sans-serif\">Unreliable high score</text><path d=\"M281 164L351 164\" fill=\"none\" stroke=\"#138477\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M340.4690092573155 169.75310646325045L351 164L340.4690092573155 158.24689353674955\" fill=\"none\" stroke=\"#138477\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M583 167L641 167\" fill=\"none\" stroke=\"#4c83bb\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M630.4690092573155 172.75310646325045L641 167L630.4690092573155 161.24689353674955\" fill=\"none\" stroke=\"#4c83bb\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M779 147V169Q744 212 576 222\" fill=\"none\" stroke=\"#cc6963\" stroke-width=\"5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-dasharray=\"9 9\"/><rect x=\"311\" y=\"282\" width
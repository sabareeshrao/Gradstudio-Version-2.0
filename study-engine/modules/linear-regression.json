165\" width=\"182\" height=\"18\" rx=\"9\" fill=\"#fff\" stroke=\"#d2e4e9\" stroke-width=\"1.5\"/><text x=\"370\" y=\"207\" font-family=\"Arial,system-ui\" font-size=\"11\" font-weight=\"750\" text-anchor=\"middle\" fill=\"#426b80\">β4</text><rect x=\"392\" y=\"192\" width=\"182\" height=\"18\" rx=\"9\" fill=\"#fff\" stroke=\"#d2e4e9\" stroke-width=\"1.5\"/><text x=\"370\" y=\"234\" font-family=\"Arial,system-ui\" font-size=\"11\" font-weight=\"750\" text-anchor=\"middle\" fill=\"#426b80\">β5</text><rect x=\"392\" y=\"219\" width=\"182\" height=\"18\" rx=\"9\" fill=\"#fff\" stroke=\"#d2e4e9\" stroke-width=\"1.5\"/><rect x=\"392\" y=\"219\" width=\"10.92\" height=\"18\" rx=\"9\" fill=\"#6cb59c\" stroke=\"#d2e4e9\" stroke-width=\"1.5\"/><rect x=\"633\" y=\"58\" width=\"283\" height=\"216\" rx=\"9\" fill=\"#fff3e8\" stroke=\"#d2e4e9\" stroke-width=\"1.5\"/><text x=\"775\" y=\"91\" font-family=\"Arial,system-ui\" font-size=\"15\" font-weight=\"750\" text-anchor=\"middle\" fill=\"#426b80\">ELASTIC NET</text><text x=\"676\" y=\"126\" font-family=\"Arial,system-ui\" font-size=\"11\" font-weight=\"750\" text-anchor=\"middle\" fill=\"#426b80\">β1</text><rect x=\"698\" y=\"111\" width=\"182\" height=\"18\" rx=\"9\" fill=\"#fff\" stroke=\"#d2e4e9\" stroke-width=\"1.5\"/><rect x=\"698\" y=\"111\" width=\"149.23999999999998\" height=\"18\" rx=\"9\" fill=\"#d9a371\" stroke=\"#d2e4e9\" stroke-width=\"1.5\"/><text x=\"676\" y=\"153\" font-family=\"Arial,system-ui\" font-size=\"11\" font-weight=\"750\" text-anchor=\"middle\" fill=\"#426b80\">β2</text><rect x=\"698\" y=\"138\" width=\"182\" height=\"18\" rx=\"9\" fill=\"#fff\" stroke=\"#d2e4e9\" stroke-width=\"1.5\"/><rect x=\"698\" y=\"138\" width=\"69.16\" height=\"18\" rx=\"9\" fill=\"#d9a371\" stroke=\"#d2e4e9\" stroke-width=\"1.5\"/><text x=\"676\" y=\"180\" font-family=\"Arial,system-ui\" font-size=\"11\" font-weight=\"750\" text-anchor=\"middle\" fill=\"#426b80\">β3</text><rect x=\"698\" y=\"165\" width=\"182\" height=\"18\" rx=\"9\" fill=\"#fff\" stroke=\"#d2e4e9\" stroke-width=\"1.5\"/><rect x=\"698\" y=\"165\" width=\"25.480000000000004\" height=\"18\" rx=\"9\" fill=\"#d9a371\" stroke=\"#d2e4e9\" stroke-width=\"1.5\"/><text x=\"676\" y=\"207\" font-family=\"Arial,system-ui\" font-size=\"11\" font-weight=\"750\" text-anchor=\"middle\" fill=\"#426b80\">β4</text><rect x=\"698\" y=\"192\" width=\"182\" height=\"18\" rx=\"9\" fill=\"#fff\" stroke=\"#d2e4e9\" stroke-width=\"1.5\"/><text x=\"676\" y=\"234\" font-family=\"Arial,system-ui\" font-size=\"11\" font-weight=\"750\" text-anchor=\"middle\" fill=\"#426b80\">β5</text><rect x=\"698\" y=\"219\" width=\"182\" height=\"18\" rx=\"9\" fill=\"#fff\" stroke=\"#d2e4e9\" stroke-width=\"1.5\"/><rect x=\"698\" y=\"219\" width=\"10.92\" height=\"18\" rx=\"9\" fill=\"#d9a371\" stroke=\"#d2e4e9\" stroke-width=\"1.5\"/><rect x=\"90\" y=\"290\" width=\"762\" height=\"33\" rx=\"9\" fill=\"#edf5f9\" stroke=\"#d2e4e9\" stroke-width=\"1.5\"/><text x=\"471\" y=\"312\" font-family=\"Arial,system-ui\" font-size=\"12\" font-weight=\"750\" text-anchor=\"middle\" fill=\"#426b80\">Standardize and tune with training-set cross-validation.</text></svg></div><p class=\"lr-note\">Ridge shrinks weights, Lasso may zero weights, and <strong>Elastic Net combines both</strong>.</p></section>",

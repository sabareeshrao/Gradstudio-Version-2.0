 stroke=\"#d2e4e9\" stroke-width=\"1.5\"/><text x=\"580\" y=\"128\" font-family=\"Arial,system-ui\" font-size=\"12\" font-weight=\"750\" text-anchor=\"middle\" fill=\"#426b80\">AREA</text><text x=\"580\" y=\"147\" font-family=\"Arial,system-ui\" font-size=\"12\" font-weight=\"750\" text-anchor=\"middle\" fill=\"#426b80\">110 m²</text><line x1=\"668\" y1=\"133\" x2=\"773\" y2=\"176\" stroke=\"#80b2a4\" stroke-width=\"2.5\"/><rect x=\"504\" y=\"166\" width=\"153\" height=\"51\" rx=\"9\" fill=\"#fff\" stroke=\"#d2e4e9\" stroke-width=\"1.5\"/><text x=\"580\" y=\"186\" font-family=\"Arial,system-ui\" font-size=\"12\" font-weight=\"750\" text-anchor=\"middle\" fill=\"#426b80\">BEDS</text><text x=\"580\" y=\"205\" font-family=\"Arial,system-ui\" font-size=\"12\" font-weight=\"750\" text-anchor=\"middle\" fill=\"#426b80\">3</text><line x1=\"668\" y1=\"191\" x2=\"773\" y2=\"176\" stroke=\"#80b2a4\" stroke-width=\"2.5\"/><rect x=\"504\" y=\"224\" width=\"153\" height=\"51\" rx=\"9\" fill=\"#fff\" stroke=\"#d2e4e9\" stroke-width=\"1.5\"/><text x=\"580\" y=\"244\" font-family=\"Arial,system-ui\" font-size=\"12\" font-weight=\"750\" text-anchor=\"middle\" fill=\"#426b80\">AGE</text><text x=\"580\" y=\"263\" font-family=\"Arial,system-ui\" font-size=\"12\" font-weight=\"750\" text-anchor=\"middle\" fill=\"#426b80\">12 years</text><line x1=\"668\" y1=\"249\" x2=\"773\" y2=\"176\" stroke=\"#80b2a4\" stroke-width=\"2.5\"/><rect x=\"787\" y=\"142\" width=\"114\" height=\"70\" rx=\"9\" fill=\"#fff\" stroke=\"#d2e4e9\" stroke-width=\"1.5\"/><text x=\"844\" y=\"171\" font-family=\"Arial,system-ui\" font-size=\"17\" font-weight=\"750\" text-anchor=\"middle\" fill=\"#426b80\">PRICE</text></svg></div><p class=\"lr-note\">Features are the inputs; the target is the value <strong>being predicted</strong>.</p></section>",

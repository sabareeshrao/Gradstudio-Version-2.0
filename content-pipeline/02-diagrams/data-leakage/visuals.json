    {
      "questionNumber": 1,
      "html": "<section class=\"g2-figure\" data-scene=\"dl-score-mirage\"><span class=\"g2-kicker\">VISUAL 01 · DATA LEAKAGE</span><h3>A score mirage from future information</h3><div class=\"g2-canvas\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 940 370\" role=\"img\" aria-label=\"Two sample results: 97 percent with leakage and 68 percent on a realistic future holdout; percentages illustrate the phenomenon rather than actual performance measurements\"><rect x=\"1\" y=\"1\" width=\"938\" height=\"368\" rx=\"17\" fill=\"#fcfeff\" stroke=\"#d6e7eb\" stroke-width=\"2\"/><text x=\"40\" y=\"44\" fill=\"#1f4054\" font-size=\"19\" font-weight=\"900\" text-anchor=\"start\" font-family=\"system-ui,Arial,sans-serif\">A SCORE THAT LOOKS TOO GOOD</text><rect x=\"43\" y=\"73\" width=\"410\" height=\"237\" rx=\"19\" fill=\"#ffffff\" stroke=\"#d5e4e9\" stroke-width=\"2\"/><text x=\"75\" y=\"113\" fill=\"#cc6963\" font-size=\"23\" font-weight=\"850\" text-anchor=\"start\" font-family=\"system-ui,Arial,sans-serif\">Leaky testing</text><rect x=\"93\" y=\"148\" width=\"267\" height=\"31\" rx=\"15\" fill=\"#ffebe9\" stroke=\"none\" stroke-width=\"2\"/><rect x=\"93\" y=\"148\" width=\"259\" height=\"31\" rx=\"15\" fill=\"#cc6963\" stroke=\"none\" stroke-width=\"2\"/><text x=\"379\" y=\"174\" fill=\"#cc6963\" font-size=\"27\" font-weight=\"900\" text-anchor=\"start\" font-family=\"system-ui,Arial,sans-serif\">97%</text><text x=\"72\" y=\"223\" fill=\"#567080\" font-size=\"18\" font-weight=\"700\" text-anchor=\"start\" font-family=\"system-ui,Arial,sans-serif\">Future outcome accidentally</text><text x=\"72\" y=\"250\" fill=\"#567080\" font-size=\"18\" font-weight=\"700\" text-anchor=\"start\" font-family=\"system-ui,Arial,sans-serif\">revealed during training</text><rect x=\"492\" y=\"73\" width=\"408\" height=\"237\" rx=\"19\" fill=\"#ffffff\" stroke=\"#d5e4e9\" stroke-width=\"2\"/><text x=\"523\" y=\"113\" fill=\"#138477\" font-size=\"23\" font-weight=\"850\" text-anchor=\"start\" font-family=\"system-ui,Arial,sans-serif\">Real future holdout</text><rect x=\"546\" y=\"148\" width=\"267\" height=\"31\" rx=\"15\" fill=\"#e4f5ed\" stroke=\"none\" stroke-width=\"2\"/><rect x=\"546\" y=\"148\" width=\"181\" height=\"31\" rx=\"15\" fill=\"#138477\" stroke=\"none\" stroke-width=\"2\"/><text x=\"835\" y=\"174\" fill=\"#138477\" font-size=\"27\" font-weight=\"900\" text-anchor=\"start\" font-family=\"system-ui,Arial,sans-serif\">68%</text><text x=\"519\" y=\"223\" fill=\"#567080\" font-size=\"18\" font-weight=\"700\" text-anchor=\"start\" font-family=\"system-ui,Arial,sans-serif\">Only prediction-time facts</text><text x=\"519\" y=\"250\" fill=\"#567080\" font-size=\"18\" font-weight=\"700\" text-anchor=\"start\" font-family=\"system-ui,Arial,sans-serif\">Illustrative values only</text><rect x=\"305\" y=\"320\" width=\"335\" height=\"34\" rx=\"17\" fill=\"#fff2db\" stroke=\"none\" stroke-width=\"2\"/><text x=\"472.5\" y=\"343\" fill=\"#93692a\" font-size=\"16\" font-weight=\"800\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">Leakage can inflate an evaluation</text></svg></div><p class=\"g2-note\">High scores may be misleading when target outcomes or future events appear among the training inputs.</p></section>"
    },
    {
      "questionNumber": 2,
      "html": "<section class=\"g2-figure\" data-scene=\"dl-leakage-routes\"><span class=\"g2-kicker\">VISUAL 02 · DATA LEAKAGE</span><h3>Two different ways information crosses a boundary</h3><div class=\"g2-canvas\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 940 370\" role=\"img\" aria-label=\"Target leakage feeds a later collection notice into a loan model, while test contamination feeds held-out statistics into a scaler fit\"><rect x=\"1\" y=\"1\" width=\"938\" height=\"368\" rx=\"17\" fill=\"#fcfeff\" stroke=\"#d6e7eb\" stroke-width=\"2\"/><text x=\"43\" y=\"43\" fill=\"#cc6963\" font-size=\"21\" font-weight=\"900\" text-anchor=\"start\" font-family=\"system-ui,Arial,sans-serif\">TARGET LEAKAGE</text><text x=\"510\" y=\"43\" fill=\"#4c83bb\" font-size=\"21\" font-weight=\"900\" text-anchor=\"start\" font-family=\"system-ui,Arial,sans-serif\">TRAIN–TEST CONTAMINATION</text><rect x=\"39\" y=\"68\" width=\"401\" height=\"254\" rx=\"20\" fill=\"#ffebe9\" stroke=\"#ecc3bf\" stroke-width=\"2\"/><rect x=\"67\" y=\"112\" width=\"138\" height=\"89\" rx=\"13\" fill=\"#ffffff\" stroke=\"#e5bdb9\" stroke-width=\"2\"/><text x=\"136\" y=\"148\" fill=\"#1f4054\" font-size=\"22\" font-weight=\"850\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">Loan</text><text x=\"136\" y=\"177\" fill=\"#567080\" font-size=\"17\" font-weight=\"650\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">application</text><rect x=\"260\" y=\"112\" width=\"148\" height=\"89\" rx=\"13\" fill=\"#ffffff\" stroke=\"#e5bdb9\" stroke-width=\"2\"/><text x=\"334\" y=\"148\" fill=\"#cc6963\" font-size=\"21\" font-weight=\"850\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">Collection</text><text x=\"334\" y=\"177\" fill=\"#567080\" font-size=\"17\" font-weight=\"650\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">notice later</text><path d=\"M328 215Q239 286 148 218\" fill=\"none\" stroke=\"#cc6963\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-dasharray=\"8 7\"/><text x=\"238\" y=\"295\" fill=\"#cc6963\" font-size=\"17\" font-weight=\"850\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">Future outcome enters features</text><rect x=\"484\" y=\"68\" width=\"420\" height=\"254\" rx=\"20\" fill=\"#eaf5fc\" stroke=\"#bed8e7\" stroke-width=\"2\"/><rect x=\"518\" y=\"112\" width=\"147\" height=\"91\" rx=\"13\" fill=\"#ffffff\" stroke=\"#b9d8e3\" stroke-width=\"2\"/><text x=\"592\" y=\"149\" fill=\"#138477\" font-size=\"22\" font-weight=\"850\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">TRAIN</text><text x=\"592\" y=\"178\" fill=\"#567080\" font-size=\"17\" font-weight=\"650\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">fit scaler</text><rect x=\"738\" y=\"112\" width=\"139\" height=\"91\" rx=\"13\" fill=\"#ffffff\" stroke=\"#b9d8e3\" stroke-width=\"2\"/><text x=\"806\" y=\"149\" fill=\"#4c83bb\" font-size=\"22\" font-weight=\"850\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">TEST</text><text x=\"806\" y=\"178\" fill=\"#567080\" font-size=\"17\" font-weight=\"650\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">held out</text><path d=\"M789 218Q687 291 592 218\" fill=\"none\" stroke=\"#cc6963\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-dasharray=\"8 7\"/><text x=\"695\" y=\"295\" fill=\"#cc6963\" font-size=\"17\" font-weight=\"850\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">Test statistics influence fit</text></svg></div><p class=\"g2-note\">Target leakage uses unavailable outcome clues. Train–test contamination lets held-out information influence training.</p></section>"
    },
    {
      "questionNumber": 3,
      "html": "<section class=\"g2-figure\" data-scene=\"dl-training-median\"><span class=\"g2-kicker\">VISUAL 03 · DATA LEAKAGE</span><h3>One set of training statistics</h3><div class=\"g2-canvas\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 940 370\" role=\"img\" aria-label=\"Median of training ages 20 and 30 is 25; a test age 90 does not contribute to this fitted median\"><rect x=\"1\" y=\"1\" width=\"938\" height=\"368\" rx=\"17\" fill=\"#fcfeff\" stroke=\"#d6e7eb\" stroke-width=\"2\"/><text x=\"45\" y=\"47\" fill=\"#138477\" font-size=\"20\" font-weight=\"900\" text-anchor=\"start\" font-family=\"system-ui,Arial,sans-serif\">FIT ONLY ON TRAINING AGES</text><text x=\"611\" y=\"47\" fill=\"#4c83bb\" font-size=\"20\" font-weight=\"900\" text-anchor=\"start\" font-family=\"system-ui,Arial,sans-serif\">KEEP TEST UNSEEN</text><rect x=\"42\" y=\"70\" width=\"480\" height=\"241\" rx=\"20\" fill=\"#e4f5ed\" stroke=\"#b5dacc\" stroke-width=\"2\"/><rect x=\"72\" y=\"115\" width=\"181\" height=\"76\" rx=\"13\" fill=\"#ffffff\" stroke=\"#b5dacc\" stroke-width=\"2\"/><text x=\"163\" y=\"150\" fill=\"#138477\" font-size=\"30\" font-weight=\"900\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">20</text><text x=\"163\" y=\"177\" fill=\"#567080\" font-size=\"16\" font-weight=\"650\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">Training</text><rect x=\"278\" y=\"115\" width=\"181\" height=\"76\" rx=\"13\" fill=\"#ffffff\" stroke=\"#b5dacc\" stroke-width=\"2\"/><text x=\"370\" y=\"150\" fill=\"#138477\" font-size=\"30\" font-weight=\"900\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">30</text><text x=\"370\" y=\"177\" fill=\"#567080\" font-size=\"16\" font-weight=\"650\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">Training</text><text x=\"276\" y=\"239\" fill=\"#1f4054\" font-size=\"29\" font-weight=\"900\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">Median = 25</text><rect x=\"100\" y=\"263\" width=\"358\" height=\"34\" rx=\"17\" fill=\"#ffffff\" stroke=\"none\" stroke-width=\"2\"/><text x=\"279\" y=\"286\" fill=\"#138477\" font-size=\"16\" font-weight=\"800\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">Use 25 for a missing test age</text><path d=\"M565 72V311\" fill=\"none\" stroke=\"#cc6963\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-dasharray=\"7 7\"/><rect x=\"606\" y=\"70\" width=\"291\" height=\"241\" rx=\"20\" fill=\"#eaf5fc\" stroke=\"#bed9e5\" stroke-width=\"2\"/><text x=\"749\" y=\"134\" fill=\"#4c83bb\" font-size=\"41\" font-weight=\"900\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">90</text><text x=\"749\" y=\"171\" fill=\"#567080\" font-size=\"18\" font-weight=\"700\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">Held-out test age</text><text x=\"749\" y=\"226\" fill=\"#cc6963\" font-size=\"22\" font-weight=\"900\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">NOT used to fit</text><text x=\"749\" y=\"260\" fill=\"#567080\" font-size=\"16\" font-weight=\"650\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">Transform afterward</text><path d=\"M517 238H603\" fill=\"none\" stroke=\"#138477\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-dasharray=\"5 6\"/><circle cx=\"524\" cy=\"238\" r=\"5\" fill=\"#138477\"/><circle cx=\"601\" cy=\"238\" r=\"5\" fill=\"#138477\"/></svg></div><p class=\"g2-note\">Fit statistics using training records. Later, reuse those fitted statistics on held-out records.</p></section>"
    },

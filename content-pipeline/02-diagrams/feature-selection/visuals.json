height=\"84\" rx=\"12\" fill=\"#fff\" stroke=\"#d5e4dc\" stroke-width=\"2\"/><text x=\"294\" y=\"156\" fill=\"#233D56\" font-size=\"18\" font-weight=\"850\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">History</text><text x=\"294\" y=\"181\" fill=\"#177C70\" font-size=\"15\" font-weight=\"800\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">keep</text><rect x=\"346\" y=\"121\" width=\"88\" height=\"84\" rx=\"12\" fill=\"#FFF0EA\" stroke=\"#d5e4dc\" stroke-width=\"2\"/><text x=\"390\" y=\"156\" fill=\"#D16F5F\" font-size=\"15\" font-weight=\"850\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">Reference</text><text x=\"390\" y=\"181\" fill=\"#D16F5F\" font-size=\"15\" font-weight=\"800\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">remove</text><rect x=\"93\" y=\"251\" width=\"289\" height=\"34\" rx=\"17\" fill=\"#fff\" stroke=\"none\" stroke-width=\"2\"/><text x=\"237.5\" y=\"274\" fill=\"#177C70\" font-size=\"16\" font-weight=\"850\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">SELECT · values unchanged</text><rect x=\"517\" y=\"118\" width=\"147\" height=\"88\" rx=\"15\" fill=\"#fff\" stroke=\"#cfc7e6\" stroke-width=\"2\"/><text x=\"590\" y=\"155\" fill=\"#7965AD\" font-size=\"18\" font-weight=\"750\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">Age</text><text x=\"590\" y=\"182\" fill=\"#7965AD\" font-size=\"18\" font-weight=\"750\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">Price</text><rect x=\"723\" y=\"117\" width=\"150\" height=\"93\" rx=\"15\" fill=\"#fff\" stroke=\"#cfc7e6\" stroke-width=\"2\"/><text x=\"797\" y=\"157\" fill=\"#7965AD\" font-size=\"23\" font-weight=\"900\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">PC1</text><text x=\"797\" y=\"184\" fill=\"#5B7188\" font-size=\"15\" font-weight=\"650\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">0.7A + 0.7P</text><path d=\"M669 164L718 164\" stroke=\"#7965AD\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/<path d=\"M707.4690092573155 169.75310646325045L718 164L707.4690092573155 158.24689353674955\" stroke=\"#7965AD\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/<rect x=\"540\" y=\"253\" width=\"308\" height=\"34\" rx=\"17\" fill=\"#fff\" stroke=\"none\" stroke-width=\"2\"/><text x=\"694\" y=\"276\" fill=\"#7965AD\" font-size=\"16\" font-weight=\"850\" text-anchor=\"middle\" font-family=\"system-ui,Arial,sans-serif\">EXTRACT · new combined values</text></svg></div><p class=\"fs2-note\">Selection keeps original columns. Extraction forms new representations, such as principal components.</p></section>"
